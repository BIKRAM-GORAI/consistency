# =========================================================================
# Consistency Tracker — Root Server Environment Configuration Template
# =========================================================================
# Copy this file to .env and fill in the values for local development.
# Do NOT commit your actual .env file to version control!
# =========================================================================

# --- Database & Port ---
# MongoDB connection URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGO_URI=mongodb://localhost:27017/consistency_local
# Server listening port
PORT=5001

# --- Frontend Deployment URL ---
# The URL of your web frontend client (used for CORS and verification redirect links)
FRONTEND_URL=http://localhost:5001

# --- Security & JWT Sessions ---
# Secret key used to sign JWT access tokens (use a long random string)
JWT_SECRET=your_jwt_signing_secret_here
# Token lifetime/expiry configuration (e.g. 7d, 24h)
JWT_EXPIRY=7d
# Shared secret for cron route execution authorization (provided in Bearer header)
CRON_SECRET=your_cron_auth_secret_here

# --- Email (SMTP Configuration via Gmail) ---
# Gmail address used to send verification and notification emails
GMAIL_EMAIL=example@gmail.com
# Google App Password (NOT your account password; generate via Google Account Security page)
GMAIL_APP_PASSWORD=your_gmail_app_specific_password_here

# --- Firebase Service Account Credentials ---
# Required for user authentication validation and Firestore chat sync
FIREBASE_PROJECT_ID=consistency-daily
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@consistency-daily.iam.gserviceaccount.com
# The private key must contain newline escaping (\n) in the environment variable string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Cloudinary Asset Management ---
# Credentials for storage of profile pictures, group icons, and chat media attachments
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Administrative Dashboard Credentials ---
# Username (email) and password for accessing the /admin-dashboard.html portal
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_secure_password
# Admin OTP recipient (resets and dashboard bypass authentication)
ADMIN_BACKUP_OTP=xxxxxx
ADMIN_OTP_RECIPIENT_EMAIL=admin_backup@example.com

# --- Reviews Portal Configuration ---
# Admin password for seeing private reviews if turned to private
REVIEW_ADMIN_PASSWORD=review_admin_password
# Mode for public reviews page ('public' or 'private')
REVIEW_ACCESS_MODE=public

# --- Limits & Controls ---
# Group join limits per user
PUBLIC_GROUP_LIMIT=5
PRIVATE_GROUP_LIMIT=5
# Maximum rankings displayed in leaderboards
MAX_RANKINGS_SHOWN=5
# Percentage of group members required to view a chat message for blue ticks (0-100)
CHAT_READ_THRESHOLD_PCT=10

# --- Chat Rate Limits (Messages per user per hour) ---
CHAT_IMAGE_LIMIT=20
CHAT_AUDIO_LIMIT=20
CHAT_AUDIO_FILE_LIMIT=5
CHAT_STICKER_LIMIT=30

# --- AI Microservice Configuration ---
# Endpoint URL for the standalone AI generation service (Render hosting or local)
AI_SERVICE_URL=http://localhost:5002
# Shared HMAC API secret header for authenticating with the AI service
AI_SERVICE_SECRET=your_ai_microservice_shared_secret_here
# Daily limit of AI reports a standard user can generate
AI_DAILY_LIMIT=15
