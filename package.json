{
  "name": "daily-consistency-tracker",
  "version": "1.0.0",
  "description": "Daily Consistency Tracker + Long-Term Goal Manager",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/push-notifications": "^8.1.1",
    "@capawesome/capacitor-google-sign-in": "^0.1.2",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "jsonwebtoken": "^9.0.3",
    "lucide": "^1.14.0",
    "mongoose": "^8.2.3",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": "22.x"
  },
  "nodemonConfig": {
    "watch": [
      "backend"
    ],
    "ext": "js,json",
    "ignore": [
      "frontend",
      "brain",
      "artifacts",
      "node_modules",
      ".git",
      "knowledge"
    ],
    "delay": "1000"
  }
}
